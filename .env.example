# ローカルでスクリプトを実行するための環境変数テンプレート。
# 実際の値はここには書かない。`cp .env.example .env` した上で、
# プロジェクトオーナー(kazu098)から値を共有してもらって埋める。
#
# .env はgitignore対象なのでコミットされない。

# Discord Bot (会員照合・投稿収集・イベント収集・コメント通知で使用)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Googleフォーム回答シート (会員住所同期で使用)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Form Responses 1

# Supabase (会員データ・イベント・コミュニティ投稿の保存先)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# YouTubeコメント通知 (scripts/notify_youtube_comments.py)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_ID=
DISCORD_DM_USER_ID=
DISCORD_NOTIFY_USER_ID=
