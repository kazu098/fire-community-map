        { "start": "0:23.5", "end": "0:25", "text": "もう5年とかぐらいかな", "accent": true },
        { "start": "0:25", "end": "0:29", "text": "目標資産が貯まってからの", "accent": false },
        { "start": "0:29", "end": "0:32", "text": "悩んでる時間って", "accent": false },
        { "start": "0:32", "end": "0:35", "text": "本当にもったいなかったです", "accent": true },
        { "start": "0:35", "end": "0:40", "text": "会社員だと自由時間って\n1日1時間しかない", "accent": false },
        { "start": "0:40", "end": "0:45", "text": "FIREすると自由時間が\n16時間ぐらいになる", "accent": false },
        { "start": "0:45", "end": "0:50", "text": "5年間伸ばしちゃいましたけど", "accent": false },
        { "start": "0:50", "end": "0:53", "text": "楽しみな時間を\n無駄にしたかも", "accent": true }
