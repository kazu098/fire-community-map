        { "start": "0:05.5", "end": "0:09.5", "text": "もっと早く\nやめときゃよかった", "accent": true },
        { "start": "0:09.5", "end": "0:14.5", "text": "お金的には\nもうちょっと早くやめられてた", "accent": false },
